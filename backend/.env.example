# ==========================================
# ВАЖНО: Сгенерируйте безопасные пароли!
# ==========================================
# Используйте команду для генерации:
# openssl rand -base64 32

# PostgreSQL Database
POSTGRES_USER=childs_health
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
POSTGRES_DB=childs_health_db

# Database URL (используйте тот же пароль что и POSTGRES_PASSWORD)
DATABASE_URL=postgresql://childs_health:CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32@postgres:5432/childs_health_db

# Yandex Object Storage (S3)
# Получите в: https://console.cloud.yandex.com
YC_STORAGE_ACCESS_KEY=your_access_key_here
YC_STORAGE_SECRET_KEY=your_secret_key_here
YC_STORAGE_BUCKET_NAME=childs-health-files
YC_STORAGE_ENDPOINT=https://storage.yandexcloud.net
YC_STORAGE_REGION=ru-central1

# JWT Secret (ОБЯЗАТЕЛЬНО замените!)
# Сгенерируйте: openssl rand -base64 32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
JWT_ALGORITHM=HS256

# QR Token Settings
QR_TOKEN_EXPIRE_HOURS=48  # 2 дня

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# CORS Settings (разделяйте запятыми)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Application
APP_NAME=Child's Health Card API
APP_VERSION=1.0.0
DEBUG=True

# ==========================================
# ИНСТРУКЦИЯ ПО УСТАНОВКЕ:
# ==========================================
# 1. Скопируйте этот файл: cp .env.example .env
# 2. Сгенерируйте пароли:
#    POSTGRES_PASSWORD=$(openssl rand -base64 32)
#    JWT_SECRET_KEY=$(openssl rand -base64 32)
# 3. Замените значения в .env файле
# 4. Получите Yandex Cloud credentials и замените placeholder значения
# 5. Для продакшена установите DEBUG=False
# ==========================================
