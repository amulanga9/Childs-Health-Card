# Database
DATABASE_URL=postgresql://user:password@localhost:5432/childs_health_db

# Yandex Object Storage (S3)
YC_STORAGE_ACCESS_KEY=your_access_key_here
YC_STORAGE_SECRET_KEY=your_secret_key_here
YC_STORAGE_BUCKET_NAME=childs-health-files
YC_STORAGE_ENDPOINT=https://storage.yandexcloud.net
YC_STORAGE_REGION=ru-central1

# JWT Secret
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256

# QR Token Settings
QR_TOKEN_EXPIRE_HOURS=48  # 2 дня

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# CORS Settings
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Application
APP_NAME=Child's Health Card API
APP_VERSION=1.0.0
DEBUG=True
